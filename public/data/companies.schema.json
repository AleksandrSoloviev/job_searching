{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aleksandrsoloviev.github.io/job_searching/data/companies.schema.json",
  "title": "Каталог целевых компаний",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "anyOf": [
    { "required": ["companies"] },
    { "required": ["pages"] }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "companies": {
      "type": "array",
      "description": "Плоский снимок. При загрузке старой копии или сида становится одной страницей. При импорте в уже открытый каталог — новая страница.",
      "items": { "$ref": "#/$defs/company" }
    },
    "pages": {
      "type": "array",
      "description": "Батчи компаний. Экспорт приложения пишет страницы целиком.",
      "items": { "$ref": "#/$defs/page" }
    },
    "activePageIndex": {
      "type": "integer",
      "minimum": 0,
      "description": "Индекс открытой страницы. Необязателен; при загрузке ограничивается числом страниц."
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "companies"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "companies": {
          "type": "array",
          "items": { "$ref": "#/$defs/company" }
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "website": { "type": "string" },
        "email": { "type": "string" },
        "coverLetter": {
          "type": "string",
          "description": "Сопроводительное письмо обычной строкой. Пустая строка допустима."
        },
        "fameRank": {
          "type": "number",
          "description": "Меньше — известнее, выше в таблице и списке текущей страницы. Нет поля — в конец. GrokBot MAY задавать."
        },
        "vacancies": {
          "type": "array",
          "items": { "$ref": "#/$defs/vacancy" }
        },
        "vacanciesSource": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "vacancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string" },
        "summary": { "type": "string" },
        "lastAppliedAt": {
          "type": "string",
          "description": "Дата последнего отклика на эту вакансию: YYYY-MM-DD или пустая строка.",
          "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
